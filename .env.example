# ---- Required ----
# PostgreSQL. Local socket example: postgresql://USER@localhost/clothing_ecom?host=/var/run/postgresql
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clothing_ecom"
# Public base URL (used for sitemap, canonical URLs, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Razorpay (online payments). Leave empty to run with cash on delivery only. ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""        # same value as RAZORPAY_KEY_ID
RAZORPAY_WEBHOOK_SECRET=""            # set in Razorpay Dashboard → Webhooks

# ---- Scheduled job: releases stock held by unpaid online orders ----
CRON_SECRET="change-me-to-a-long-random-string"

# ---- Images: S3 + CloudFront. Leave empty in development to store uploads in public/uploads. ----
AWS_REGION=""
S3_BUCKET=""
NEXT_PUBLIC_CDN_URL=""                # e.g. https://dxxxxxxxx.cloudfront.net
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY only if not using an IAM role
