# =====================================================================
# Production environment for AWS deployment (App Runner / ECS).
#
# Copy to .env.production ONLY on the build machine, or better: put each
# value in AWS Secrets Manager / SSM Parameter Store and inject it into the
# container. Never commit real values.
#
#   [build]   baked into the client bundle at `docker build` time — pass as
#             --build-arg (see Dockerfile). Changing them needs a rebuild.
#   [runtime] read by the server at start — set on the App Runner service.
#   [secret]  store in Secrets Manager, not plain environment variables.
# =====================================================================

NODE_ENV="production"

# ---------------------------------------------------------------------
# Database — Amazon RDS for PostgreSQL 16            [runtime][secret]
# Use the RDS endpoint, force TLS, and cap connections per instance.
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://APP_USER:STRONG_PASSWORD@your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/clothing_ecom?sslmode=require&connection_limit=10"

# ---------------------------------------------------------------------
# Public site URL (canonical links, sitemap, Open Graph)  [build][runtime]
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.yourstore.com"

# ---------------------------------------------------------------------
# Razorpay — LIVE keys (Dashboard → Account & Settings → API Keys)
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"                  # [runtime]
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"             # [runtime][secret]
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"      # [build] same as RAZORPAY_KEY_ID
# Dashboard → Webhooks → https://www.yourstore.com/api/payments/razorpay/webhook
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"         # [runtime][secret]

# ---------------------------------------------------------------------
# Scheduled job secret                                [runtime][secret]
# EventBridge Scheduler calls POST /api/cron/release-reservations every
# 5 minutes with header:  Authorization: Bearer <CRON_SECRET>
# Generate:  openssl rand -hex 32
# ---------------------------------------------------------------------
CRON_SECRET="replace-with-output-of-openssl-rand-hex-32"

# ---------------------------------------------------------------------
# Product images — S3 bucket served through CloudFront
# ---------------------------------------------------------------------
AWS_REGION="ap-south-1"                                    # [runtime]
S3_BUCKET="yourstore-product-images"                       # [runtime]
NEXT_PUBLIC_CDN_URL="https://dxxxxxxxxxxxxx.cloudfront.net"  # [build][runtime] no trailing slash
# Prefer an IAM instance role with s3:PutObject on arn:aws:s3:::BUCKET/products/*.
# Only if you can't use a role:
# AWS_ACCESS_KEY_ID=""                                     # [runtime][secret]
# AWS_SECRET_ACCESS_KEY=""                                 # [runtime][secret]

# ---------------------------------------------------------------------
# One-off: creating the first admin (not needed by the running app)
#   ADMIN_PASSWORD='long-unique-password' npm run admin:create -- owner@yourstore.com "Owner Name"
# ---------------------------------------------------------------------
